# {{ ansible_managed }}
# Git configuration

[user]
    name = {{ git_user_name }}
    email = {{ git_user_email }}

[core]
    editor = {{ git_editor | default('nvim') }}
    autocrlf = input
    pager = delta
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default

[rebase]
    autoStash = true

[alias]
    # Status and info
    st = status
    s = status -sb
    
    # Branching
    br = branch
    co = checkout
    cb = checkout -b
    
    # Commits
    ci = commit
    cm = commit -m
    ca = commit --amend
    can = commit --amend --no-edit
    
    # Logging
    lg = log --oneline --graph --decorate
    ll = log --oneline -20
    last = log -1 HEAD --stat
    
    # Diff
    d = diff
    ds = diff --staged
    
    # Stash
    sl = stash list
    sp = stash pop
    ss = stash save
    
    # Undo
    unstage = reset HEAD --
    undo = reset --soft HEAD~1
    
    # Utility
    aliases = config --get-regexp alias
    branches = branch -a
    remotes = remote -v

{% if ansible_facts.os_family == 'Darwin' %}
[credential]
    helper = osxkeychain
{% endif %}

[delta]
    navigate = true
    side-by-side = false
    line-numbers = true

[interactive]
    diffFilter = delta --color-only

{% if is_work_machine | default(false) %}
# Work-specific settings
[url "git@github.com:"]
    insteadOf = https://github.com/
{% endif %}

# Include local config for machine-specific overrides
[include]
    path = ~/.gitconfig.local
